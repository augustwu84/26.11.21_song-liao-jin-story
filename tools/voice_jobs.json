  "rate": "+10%",
  "pitch": "+22Hz"
 },
 {
  "key": "7_l1",
  "text": "留個問題給你們：為什麼主張抗金的岳飛，反而不受朝廷支持？",
  "voice": "zh-TW-HsiaoYuNeural",
  "rate": "+6%",
  "pitch": "+21Hz"
 },
 {
  "key": "7_l2",
  "text": "阿晃哥，你覺得呢？",
